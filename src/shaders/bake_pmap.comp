// CATHEDRA - bake the orbit section's world map (equirectangular):
// R = elevation (sea level .5), G = city lights + highways, B = cloud cover, A = moisture.
layout(local_size_x=8,local_size_y=8) in;
layout(rgba16f,set=0,binding=17) writeonly uniform image2D MO;
vec3 hv3(vec3 c){ ivec3 i=ivec3(c); uint h=hu(uint(i.x)+hu(uint(i.y)*7U+hu(uint(i.z)*13U+9U))); return vec3(hf(h),hf(h^0x9e3779b9U),hf(h*3U+1U)); }
vec3 wor(vec3 p){
  vec3 c=floor(p), f=p-c; float a=9., b=9., id=0.;
  for(int z=-1;z<=1;z++) for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++){
    vec3 o=vec3(x,y,z), r=o+hv3(c+o)-f; float d=dot(r,r);
    if(d<a){ b=a; a=d; id=hv3(c+o+17.).x; } else b=min(b,d);
  }
  return vec3(sqrt(a),sqrt(b),id);
}
float elev(vec3 n){
  vec3 w=n*1.7+(vec3(fbm(n*2.5,5),fbm(n*2.5+5.,5),fbm(n*2.5+9.,5))-.5)*1.1;
  return fbm(w+3.,9);
}
void main(){
  ivec2 id=ivec2(gl_GlobalInvocationID.xy)+ivec2(0,int(U.x)), sz=imageSize(MO);
  float lon=(float(id.x)+.5)/float(sz.x)*6.2832-PI, lat=((float(id.y)+.5)/float(sz.y)-.5)*PI;
  vec3 n=vec3(cos(lat)*cos(lon),sin(lat),cos(lat)*sin(lon));
  vec3 w=n*1.7+(vec3(fbm(n*2.5,5),fbm(n*2.5+5.,5),fbm(n*2.5+9.,5))-.5)*1.1;
  float e=fbm(w+3.,9);
  float rid=1.-abs(fbm(n*6.+w,6)*2.-1.);
  e+=rid*rid*rid*.14*smoothstep(.5,.58,e)+(fbm(n*60.,4)-.5)*.02;   // ridged ranges
  // river basins: dendritic channels (warped Worley edges at two scales) cut the lowlands
  vec3 rv=wor(n*55.+w*3.), rv2=wor(n*170.+w*4.);
  float riv=max(smoothstep(.03,.0,rv.y-rv.x),smoothstep(.04,.0,rv2.y-rv2.x)*.6)*smoothstep(.6,.52,e)*smoothstep(.502,.51,e);
  e-=riv*.006;
  float land=smoothstep(.5,.505,e);
  float moist=clamp(fbm(n*3.+w*.5+20.,6)+.25*cos(lat*3.)-.1+riv*.4,0.,1.);
  // cities: metro regions on coasts and plains (warped Worley, ragged suburbs), filled with a
  // street network (Worley cell edges at two scales) and lit blocks; 4 jittered sub-samples per
  // texel for the fine part (supersampled bake), dim highways between the metros
  vec3 c1=wor(n*22.+w*.8), c2=wor(n*75.+w*.5), hw=wor(n*14.);
  float coast=smoothstep(.62,.505,e)*land*smoothstep(1.35,.9,abs(lat)*1.2);
  float env=max(smoothstep(.62,.05,c1.x)*step(.42,c1.z),smoothstep(.45,.0,c2.x)*step(.55,c2.z)*.6)*coast;
  env*=smoothstep(.3,.62,fbm(n*110.+w,4)+env*.35);
  float core=smoothstep(.3,.0,c1.x)*step(.42,c1.z)*coast, fine=0.;
  vec3 tu=normalize(cross(n,vec3(0,1,0))+1e-5), tv=cross(n,tu);
  for(int k=0;k<4;k++){
    vec2 o=(vec2(k&1,k>>1)-.5)*.5*6.2832/float(sz.x);
    vec3 m=normalize(n+tu*o.x*cos(lat)+tv*o.y);
    vec3 r1=wor(m*900.), r2=wor(m*2600.);
    fine+=smoothstep(.08,.0,r1.y-r1.x)*.9+smoothstep(.1,.0,r2.y-r2.x)*.55+step(.62,hv3(floor(m*5200.)).x)*.7;
  }
  float city=env*(fine*.25*(.6+.8*core)+core*.25);
  city+=smoothstep(.025,.0,hw.y-hw.x)*land*smoothstep(.75,.505,e)*.12*step(.3,hw.z)*step(.5,hv3(floor(n*3000.)).y);
  // cloud regimes: warped synoptic field; ridged frontal bands curling through
  // the mid-latitudes; ITCZ convective clusters; trade-cumulus speckle over the subtropical sea;
  // closed-cell stratocumulus decks off the west coasts (land just east, subtropics) opening westward
  vec3 cw=n*4.+(vec3(fbm(n*3.+1.,4),fbm(n*3.+4.,4),fbm(n*3.+6.,4))-.5)*2.5;
  float al=abs(lat), sea=1.-land, big=fbm(cw,8)+.12*cos(lat*6.)-.04;
  float cl=smoothstep(.45,.73,big)*(.5+.5*fbm(n*90.+cw,5));
  float fr=1.-abs(fbm(cw*.6+7.,6)*2.-1.); cl=max(cl,pow(fr,5.)*smoothstep(.4,.65,al)*smoothstep(1.25,.95,al)*(.6+.6*fbm(n*120.+cw*3.,4)));
  vec3 cc=wor(n*38.+cw*.7+fbm(n*60.,4)*.8); cl=max(cl,smoothstep(.22,.04,abs(lat-.06*sin(lon*2.)))*smoothstep(.75,.15,cc.x+(fbm(n*160.,4)-.5)*.7)*step(.4,cc.z)*(.6+.5*fbm(n*200.,3)));   // ragged convective clusters + anvil spread
  float ea=0.; for(int k=1;k<4;k++){ float lk=lon+float(k)*.09; ea=max(ea,smoothstep(.5,.51,elev(vec3(cos(lat)*cos(lk),sin(lat),cos(lat)*sin(lk))))*(1.-float(k)*.2)); }
  vec3 sc=wor(n*150.+cw*.8); float dk=ea*sea*smoothstep(.15,.3,al)*smoothstep(.7,.45,al);
  cl=max(cl,dk*(.5+.5*smoothstep(0.,.12,sc.y-sc.x))*smoothstep(.2,.5,fbm(n*30.,4)+dk*.4));
  imageStore(MO,id,vec4(e,clamp(city,0.,4.),cl,moist));
}
