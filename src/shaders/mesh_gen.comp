// CATHEDRA - expand the architecture "parts" written by the CPU grammar into
// dense triangle meshes (one invocation per part). Output: GV = 3 vec4 per
// triangle (xyz, material), UV = per-vertex 2D coordinates for texturing.
layout(local_size_x=64) in;
layout(std430,set=0,binding=13) readonly buffer PB{ vec4 P[]; };
layout(std430,set=0,binding=12) writeonly buffer GB{ vec4 GV[]; };
layout(std430,set=0,binding=5) writeonly buffer UB{ vec2 UV[]; };
uint o; float M;
void tri(vec3 a, vec3 b, vec3 c, vec2 ua, vec2 ub, vec2 uc){
  uint k=o*3U; GV[k]=vec4(a,M); GV[k+1U]=vec4(b,M); GV[k+2U]=vec4(c,M);
  UV[k]=ua; UV[k+1U]=ub; UV[k+2U]=uc; o++;
}
void quad(vec3 a, vec3 b, vec3 c, vec3 d, vec2 ua, vec2 ub, vec2 uc, vec2 ud){ tri(a,b,c,ua,ub,uc); tri(a,c,d,ua,uc,ud); }
// pointed (gothic) arch outline: i in [0,2K+2], half width w, springing height h, radius factor k
vec2 arch(int i, int K, float w, float h, float k){
  float R=k*w, al=acos((w-R)/R);
  if(i==0) return vec2(-w,0.);
  if(i>=2*K+2) return vec2(w,0.);
  if(i<=K){ float a=mix(PI,al,float(i-1)/float(K)); return vec2(R-w,h)+R*vec2(cos(a),sin(a)); }
  float a=mix(al,PI,float(i-K-1)/float(K)); return vec2(w-R,h)+R*vec2(-cos(a),sin(a));
}
void main(){
  uint i=gl_GlobalInvocationID.x;
  if(i>=uint(U.y)) return;
  vec4 a=P[i*4U], b=P[i*4U+1U], c=P[i*4U+2U], d=P[i*4U+3U];
  int ty=int(a.w); M=b.w; o=uint(d.x);
  vec3 A=a.xyz, B=b.xyz, w=normalize(B-A);
  vec3 u=normalize(cross(abs(w.y)<.99?vec3(0,1,0):vec3(0,0,1),w)), v=cross(w,u);
  if(ty==0){ float e=d.z; vec3 k=u*cos(e)+v*sin(e); v=-u*sin(e)+v*cos(e); u=k; }
  float L=length(B-A);
  if(ty==0){            // frustum / prism / pyramid with N sides, stretched cross-section
    int n=int(c.z);
    for(int k=0;k<n;k++){
      float a0=c.w+6.2832*float(k)/float(n), a1=c.w+6.2832*float(k+1)/float(n);
      vec3 e0=u*cos(a0)+v*sin(a0)*d.y, e1=u*cos(a1)+v*sin(a1)*d.y;
      vec3 p0=A+e0*c.x, p1=A+e1*c.x, q0=B+e0*c.y, q1=B+e1*c.y;
      float fk=float(k);
      quad(p0,p1,q1,q0,vec2(fk,0),vec2(fk+1.,0),vec2(fk+1.,L),vec2(fk,L));
      tri(A,p1,p0,vec2(fk+.5,-1),vec2(fk+1.,0),vec2(fk,0));
      tri(B,q0,q1,vec2(fk+.5,L+1.),vec2(fk,L),vec2(fk+1.,L));
    }
  } else if(ty==1){     // flying buttress: straight coping, arched soffit, rectangular section
    vec3 hz=normalize(cross(vec3(0,1,0),B-A))*c.x;
    for(int k=0;k<10;k++){
      float s0=float(k)/10., s1=float(k+1)/10.;
      vec3 t0=mix(A,B,s0), t1=mix(A,B,s1);
      vec3 b0=t0-vec3(0,c.y+c.z*pow(2.*s0-1.,2.),0), b1=t1-vec3(0,c.y+c.z*pow(2.*s1-1.,2.),0);
      quad(t0-hz,t1-hz,t1+hz,t0+hz,vec2(s0,0),vec2(s1,0),vec2(s1,1),vec2(s0,1));
      quad(b0+hz,b1+hz,b1-hz,b0-hz,vec2(s0,0),vec2(s1,0),vec2(s1,1),vec2(s0,1));
      quad(t0+hz,t1+hz,b1+hz,b0+hz,vec2(s0,0),vec2(s1,0),vec2(s1,1),vec2(s0,1));
      quad(b0-hz,b1-hz,t1-hz,t0-hz,vec2(s0,0),vec2(s1,0),vec2(s1,1),vec2(s0,1));
    }
  } else if(ty==2||ty==3){   // pointed-arch window frame (2) or its filling panel (3); plane facing w
    vec3 x=normalize(cross(vec3(0,1,0),w)), y=vec3(0,1,0);
    float hw=c.x, h=c.y, th=c.z, dp=d.y, k=d.z; const int K=7;
    if(ty==2){
      for(int j=0;j<2*K+2;j++){
        vec2 o0=arch(j,K,hw,h,k), o1=arch(j+1,K,hw,h,k), i0=arch(j,K,hw-th,h,(k*hw-th)/(hw-th)), i1=arch(j+1,K,hw-th,h,(k*hw-th)/(hw-th));
        i0.y=max(i0.y,0.); i1.y=max(i1.y,0.);
        vec3 O0=A+x*o0.x+y*o0.y, O1=A+x*o1.x+y*o1.y, I0=A+x*i0.x+y*i0.y, I1=A+x*i1.x+y*i1.y, F=w*dp;
        quad(O0+F,O1+F,I1+F,I0+F,o0/hw,o1/hw,i1/hw,i0/hw);
        quad(O0,O1,O1+F,O0+F,o0/hw,o1/hw,o1/hw,o0/hw);
        quad(I1,I0,I0+F,I1+F,i1/hw,i0/hw,i0/hw,i1/hw);
      }
    } else {
      vec3 C=A+y*h*.6+w*dp;
      for(int j=0;j<2*K+3;j++){
        vec2 p0=arch(j,K,hw,h,k), p1=arch((j+1)%(2*K+3),K,hw,h,k);
        tri(C,A+x*p0.x+y*p0.y+w*dp,A+x*p1.x+y*p1.y+w*dp,vec2(0,h*.6)/hw,p0/hw,p1/hw);
      }
    }
  } else if(ty==4){     // tracery ring (oculus / rose) in the plane facing w
    vec3 x=normalize(cross(vec3(0,1,0),w)), y=normalize(cross(w,x));
    float r=c.x, th=c.y, dp=d.y;
    for(int k=0;k<16;k++){
      float a0=6.2832*float(k)/16., a1=6.2832*float(k+1)/16.;
      vec3 e0=x*cos(a0)+y*sin(a0), e1=x*cos(a1)+y*sin(a1), F=w*dp;
      vec3 O0=A+e0*r, O1=A+e1*r, I0=A+e0*(r-th), I1=A+e1*(r-th);
      vec2 g0=vec2(cos(a0),sin(a0)), g1=vec2(cos(a1),sin(a1));
      quad(O0+F,O1+F,I1+F,I0+F,g0,g1,g1*.8,g0*.8);
      quad(O0,O1,O1+F,O0+F,g0,g1,g1,g0);
      quad(I1,I0,I0+F,I1+F,g1,g0,g0,g1);
    }
  } else {              // rock / chunk: lumpy lat-long sphere cut by 5 random fracture planes
    float r=c.x; uint sd=uint(d.y);
    vec3 pn[5]; float pd[5];
    for(int k=0;k<5;k++){ pn[k]=normalize(vec3(hf(sd*31U+uint(k)*3U),hf(sd*31U+uint(k)*3U+1U),hf(sd*31U+uint(k)*3U+2U))-.5); pd[k]=.55+.3*hf(sd*17U+uint(k)); }
    for(int j=0;j<10;j++) for(int k=0;k<16;k++){
      vec3 q[4]; vec2 g[4];
      for(int m=0;m<4;m++){
        int jj=j+(m>>1), kk=(k+(m&1))%16;
        float th=PI*float(jj)/10., ph=6.2832*float(kk)/16.;
        vec3 dr=vec3(sin(th)*cos(ph),cos(th),sin(th)*sin(ph));
        float rr=.8+.45*fbm(dr*2.2+float(sd%97U),3);
        for(int e=0;e<5;e++){ float c2=dot(dr,pn[e]); if(c2>.05) rr=min(rr,pd[e]/c2); }
        q[m]=A+dr*rr*r*vec3(1.,.65+.6*hf(sd),1.);
        g[m]=vec2(float(kk),float(jj));
      }
      quad(q[0],q[1],q[3],q[2],g[0],g[1],g[3],g[2]);
    }
  }
}
