// CATHEDRA - per frame, one invocation per swarm element: frustum / near /
// sub-pixel LOD culling and shading for the raster pass (slot i keeps its order,
// so the blend order - and the export - stay deterministic).
// U = time, -, render height, render width
layout(local_size_x=256) in;
layout(std430,set=0,binding=7) writeonly buffer VB{ vec4 Q[]; };
void main(){
  uint i=gl_GlobalInvocationID.x, n=uint(D.length()-4)/2U;
  if(i>=n) return;
  vec4 A=D[2U*i], E=D[2U*i+1U]; vec3 nr; float s, T=U.x;
  vec3 p=swarmP(A,E,T,nr,s);
  float sz=E.x*(1.-.6*s), ty=E.y, h=fract(E.w);
  vec3 on=vec3(0,1,0); on.yz*=rot(A.y); on.xz*=rot(A.z);
  vec3 t1=cross(ty<.25?on:vec3(.3,1.,.1),nr); t1=dot(t1,t1)>1e-12?normalize(t1):vec3(1,0,0); vec3 t2=cross(nr,t1);
  vec3 a1=t1*1.6*sz, a2=t2*sz;
  Q[i*3U]=vec4(0);
  vec3 ro,ta; float roll,fl; camGet(0,ro,ta,roll,fl);
  mat3 M=camMat(ro,ta,roll);
  vec3 v=(p-ro)*M; float vd=length(p-ro), pw=v.z*2.2/(fl*U.z), r=sz*2.;
  if(sz<=0.||v.z<.02||vd<.06||abs(v.x)>v.z*U.w/(U.z*fl)+r||abs(v.y)>v.z/fl+r) return;
  // only huge near-camera panels fade out by projected size (> ~20% of the screen height; the
  // satellites read as solid craft against the star, not tinted glass)
  float va=smoothstep(.06,.1,vd)*(1.-smoothstep(.2,.35,sz*fl/v.z)), sub=0.;
  if(ty>.5){ a1=M[0]*max(sz,pw); a2=M[1]*max(sz,pw); va*=min(sz*sz/(pw*pw),1.); }
  else if(sz<pw){ va*=sz*sz*1.6/(pw*pw); a1=M[0]*pw; a2=M[1]*pw; sub=.5; }
  // stochastic LOD: faint sub-pixel elements are thinned out and the survivors carry their coverage
  if(va<.25){ if(hf(i*3U+7U)*.25>va) return; va=.25; }
  vec3 L=-normalize(p), Vw=normalize(ro-p), col;
  float irr=4./dot(p,p), fr=dot(nr,Vw);
  if(ty>.5){          // rift dust: embers cooling on their way to the star
    col=mix(vec3(.2,.04,.01),vec3(1.,.42,.12),pow(1.-s,3.))*(.3+.7*h)*(1.-s)*1.5;
  } else if(fr>0.){   // sunward face: photovoltaic (dark blue), gold foil or mirror
    vec3 al=ty<.05?vec3(.012,.02,.05):ty<.15?vec3(.5,.34,.1):vec3(.3,.31,.33);
    vec3 F0=ty<.05?vec3(.06):ty<.15?vec3(1.,.7,.3):vec3(.9,.92,.95);
    float rg=ty<.05?.18:ty<.15?.3:.06, ex=2./(rg*rg);
    vec3 F=F0+(1.-F0)*pow(1.-fr,5.);
    // the star disc mirrored in the panel (soft edge widens for sub-pixel panels: no sparkle)
    float cs=dot(reflect(-Vw,nr),L), ca=sqrt(max(1.-1./dot(p,p),0.)), sf=.004+rg*.05+sub*.03;
    float mir=smoothstep(ca-sf,ca+sf,cs);
    float lobe=pow(max(dot(nr,normalize(L+Vw+1e-6)),0.),ex)*(ex+8.)/(ex*8.+8.);
    col=al*max(dot(nr,L),0.)*irr*.7+F*(vec3(1.,.66,.36)*mir*2.5+lobe*irr*.4)+vec3(.004,.005,.008);
  } else {            // anti-sunward face: polished radiator plate - brushed metal that mirrors the
    // star-lit swarm around it (bright, never a dark square), a dim ember glow and a grazing sheen
    vec3 rf=reflect(-Vw,nr);
    float env=.35+.65*pow(max(dot(rf,L)*.5+.5,0.),3.);
    col=vec3(.32,.31,.33)*(.6+.6*h)*env*(.5+.5*min(irr,2.))+vec3(.3,.07,.015)*irr*.3*(.4+.6*h)*(ty<.05?1.:.5)
       +vec3(.6,.62,.7)*pow(1.+fr,5.)*irr*.35;
  }
  // sub-pixel elements: no dark speckle - they integrate into a smooth luminous band (the mean
  // light the panels scatter: warm star light off fronts and edges), with low opacity
  if(sub>0.&&ty<.5){ col=vec3(1.,.74,.48)*(.25+.35*h)*min(irr,3.)*.9; va*=.4; }
  if(h>.996) col+=vec3(1.,.12,.06)*step(.75,fract(T*.8+h*40.))*3.;   // navigation beacons
  else if(h<.002) col+=vec3(.3,.7,1.)*2.;
  if(ty<.5) col*=.75+.5*fract(h*37.);   // no two panels alike
  col=min(fin(col),vec3(8.));
  Q[i*3U]=vec4(p,va);
  Q[i*3U+1U]=vec4(a1,uintBitsToFloat(packHalf2x16(col.rg)));
  Q[i*3U+2U]=vec4(a2,uintBitsToFloat(packHalf2x16(vec2(col.b,ty>.5?1.:sub>0.?sub:.2*pow(max(dot(normalize(p),Vw),0.),2.)))));   // resolved: .2 x backlight (the star behind it)
}
